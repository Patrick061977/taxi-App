# HTTPS erzwingen
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Standard-Seite: landing.html (öffentliche Buchungsseite, SEO-Hauptseite)
# Die App (index.html) ist weiterhin direkt erreichbar via /index.html
DirectoryIndex landing.html index.html

# v6.66.163 (Patrick 03.10. — Google Search Console Coverage-Fix):
# Fehlende .html-Dateien MUESSEN echten 404 liefern, sonst serviert der
# SPA-Fallback die 8,77 MB index.html mit noindex,nofollow fuer JEDE
# Phantom-URL (alte Backlinks, Tippfehler, geloeschte Landingpages).
# Google indexierte dadurch nur 38 von 544 bekannten Seiten (7 %), weil
# ~201 Phantom-URLs identischen Blob-Content lieferten → Duplikat / Soft 404 /
# "Gefunden, nicht gecrawlt". Separate Regel VOR dem SPA-Fallback.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule \.html?$ - [R=404,L]

# SPA Routing - alle anderen Anfragen (clean URLs ohne .html) auf index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.html [L]

# Cache-Control fuer statische Dateien
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
