<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F4F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alarm-Einstellungen"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Testen und einstellen wie der Alarm bei neuen Fahrten klingt."
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:paddingBottom="20dp"/>

        <!-- Alarmton -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alarmton"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:paddingBottom="6dp"/>
        <Spinner
            android:id="@+id/sp_alarm_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/btn_dropdown"
            android:paddingBottom="8dp"/>

        <!-- v6.66.213: Eigenen Ton waehlen (System-Picker) -->
        <Button
            android:id="@+id/btn_pick_custom_sound"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🎵 EIGENEN SIGNALTON WAEHLEN"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#1E40AF"
            android:background="#DBEAFE"
            android:layout_marginBottom="4dp"/>
        <TextView
            android:id="@+id/tv_custom_sound_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#374151"
            android:paddingBottom="12dp"/>

        <!-- Vibration -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/sw_vibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vibration"
            android:textSize="15sp"
            android:textColor="#374151"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:checked="true"/>

        <!-- Alarm-Dauer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Alarm-Dauer"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#374151"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"/>
        <RadioGroup
            android:id="@+id/rg_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton
                android:id="@+id/rb_dur_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10 Sek"/>
            <RadioButton
                android:id="@+id/rb_dur_30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30 Sek"
                android:checked="true"/>
            <RadioButton
                android:id="@+id/rb_dur_60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="60 Sek"/>
        </RadioGroup>

        <!-- Test-Button -->
        <Button
            android:id="@+id/btn_test_alarm"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="JETZT ALARM TESTEN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#DC2626"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/tv_alarm_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:paddingTop="6dp"
            android:paddingBottom="24dp"/>

        <!-- Lautstärke-Hinweis -->
        <TextView
            android:id="@+id/tv_volume_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#374151"
            android:background="#FEF3C7"
            android:padding="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"/>

        <!-- Push-Statistik Header -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Push-Historie (letzte 20)"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:paddingBottom="4dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gruen = Push ist bei dir angekommen. Rot = Push war gesendet aber dein Handy hat ihn nicht empfangen (Doze/Offline)."
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:paddingBottom="12dp"/>

        <LinearLayout
            android:id="@+id/push_history_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView
            android:id="@+id/tv_push_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Keine Push-Historie"
            android:textSize="13sp"
            android:textColor="#9CA3AF"
            android:gravity="center"
            android:padding="20dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
